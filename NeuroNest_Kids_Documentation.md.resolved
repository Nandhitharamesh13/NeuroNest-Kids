    CHILD(["👧 Child\nLearner"])
    SUPABASE_AUTH(["🔐 Supabase\nAuth"])
    AI_ENGINE(["🤖 AI Engine\nEdge Function"])

    NEURONEST["⬡ NeuroNest Kids\nSystem"]

    PARENT -- "Sign up / Login\nCreate child profiles\nConfigure settings\nView reports" --> NEURONEST
    CHILD -- "Select games\nAnswer questions\nInteract with mascot" --> NEURONEST

    NEURONEST -- "Auth tokens\nUser session" --> SUPABASE_AUTH
    SUPABASE_AUTH -- "JWT / session data" --> NEURONEST

    NEURONEST -- "Gameplay telemetry\nBehavior profile" --> AI_ENGINE
    AI_ENGINE -- "Encouragement messages\nHints\nDifficulty adjustment" --> NEURONEST

    NEURONEST -- "Progress reports\nAlerts\nAnalytics" --> PARENT
    NEURONEST -- "Adapted questions\nFeedback\nSounds" --> CHILD
```

