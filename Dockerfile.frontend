FROM node:18-alpine AS builder

WORKDIR /app

COPY neuro-frontend/neuronest-kids/package*.json ./
RUN npm ci

COPY neuro-frontend/neuronest-kids/. ./

# Build the frontend
RUN npm run build

# Production stage
FROM nginx:alpine

# Copy built app to nginx
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
