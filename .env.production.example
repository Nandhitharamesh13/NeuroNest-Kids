# NeuroNest Kids - Production Environment Template
# Copy this to .env and fill with your production values
# NEVER commit this file to GitHub!

# ==============================
# DATABASE CONFIGURATION
# ==============================
DB_USER=neuronest_admin
DB_HOST=your-database-host.rds.amazonaws.com
DB_NAME=neuronest_production
DB_PASS=your_very_secure_password_here_change_me
DB_PORT=5432

# ==============================
# SERVER CONFIGURATION
# ==============================
NODE_ENV=production
PORT=5000

# ==============================
# FRONTEND URL (for CORS)
# ==============================
FRONTEND_URL=https://neuronest-kids.vercel.app

# ==============================
# JWT CONFIGURATION (CHANGE THIS!)
# ==============================
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_change_this

# ==============================
# LOGGING
# ==============================
LOG_LEVEL=info

# ==============================
# AI SERVER (if applicable)
# ==============================
AI_SERVER_URL=https://your-ai-server.com

# ==============================
# Optional: Sentry Error Tracking
# ==============================
# SENTRY_DSN=your_sentry_dsn_here

# ==============================
# Optional: Email Configuration
# ==============================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
